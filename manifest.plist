<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NXRomManifestVersion</key>
	<integer>1</integer>

	<key>NXRomIdentifier</key>
	<string>dev.alloycore.slate</string>

	<key>NXRomName</key>
	<string>Slate</string>

	<key>NXRomVersion</key>
	<string>0.1.0</string>

	<!-- Bump when a security fix gets shipped! -->
	<key>NXRomSecurityVersion</key>
	<integer>1</integer>

	<!-- Copied from Switzach 1.0.5. Check the current minimum. -->
	<key>NXRomMinimumNyxianVersion</key>
	<string>0.11.6.2</string>

	<!-- 420 = 0644, 493 = 0755 -->
	<key>NXRomDefaultFilePermission</key>
	<integer>420</integer>
	<key>NXRomDefaultDirectoryPermission</key>
	<integer>493</integer>

	<key>NXRomExecutable</key>
	<string>System/Rom/init</string>
	<key>NXRomUninstaller</key>
	<string>System/Rom/uninstall</string>

	<key>NXRomPaths</key>
	<array>
		<dict>
			<key>NXPath</key>
			<array>
				<string>System/Rom/init</string>
				<string>System/Rom/uninstall</string>
			</array>
			<!-- 365 = 0555 (executable) -->
			<key>NXPermission</key>
			<integer>365</integer>
			<key>NXRequiresCodeSigning</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
